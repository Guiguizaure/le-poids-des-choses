# Copie ce fichier en .dev.vars (ignoré par git) pour `wrangler pages dev` en local.
# Valeurs de test uniquement : les vraies clés ne vont que dans les secrets Cloudflare.
# Clé secrète de test de Turnstile (documentée par Cloudflare, accepte tout jeton de test).
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Clé HMAC des limites de débit : n'importe quelle chaîne en local.
HASH_SECRET=local-seulement
# Accepte l'origine http(s)://localhost (jamais en production).
ALLOW_LOCALHOST=1
# Resend : laisser vide en local (l'envoi échoue proprement) ou pointer vers un faux Resend.
RESEND_API_KEY=
# RESEND_API_URL=http://127.0.0.1:4330
# « Raconte ta journée » : coupée par défaut en local. AI_ENABLED=1 + une vraie clé = appels
# payants à Claude. La clé sert aussi à `pnpm raconte:eval` (jamais en CI).
AI_ENABLED=0
# ANTHROPIC_API_KEY=
# AI_DAILY_CAP=20
